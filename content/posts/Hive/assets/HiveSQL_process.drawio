        <mxCell id="yG9XSz6ooa5SpNMMEtbd-162" parent="yG9XSz6ooa5SpNMMEtbd-158" style="swimlane;whiteSpace=wrap;html=1;startSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: 400; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px;&quot;&gt;HIVE &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: 400;&quot;&gt;COMPILER：&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px; font-weight: 400;&quot;&gt;&lt;font face=&quot;Segoe UI&quot;&gt;将 SQL 编译为 Hive 内部 QueryPlan&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
