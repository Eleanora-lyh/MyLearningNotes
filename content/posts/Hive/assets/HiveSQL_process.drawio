          <mxGeometry height="40" width="190" x="310" y="425" as="geometry" />
        </mxCell>
        <mxCell id="yG9XSz6ooa5SpNMMEtbd-273" parent="yG9XSz6ooa5SpNMMEtbd-76" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b style=&quot;font-size: 11px; font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;步骤5&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-size: 11px; font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;.3&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-size: 11px; font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;：&lt;/font&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;ApplicationMaster&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;读取 splits/stages 作业规划&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;发起ResourceRequest，向RM申请资源，&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;请求分配多个Task Container&lt;/span&gt;" vertex="1">
          <mxGeometry height="81" width="150" y="386.25" as="geometry" />
        </mxCell>
        <mxCell id="yG9XSz6ooa5SpNMMEtbd-303" parent="yG9XSz6ooa5SpNMMEtbd-76" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;步骤5&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;.6&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;：&lt;/font&gt;&lt;/b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 255));&quot;&gt;Map 完成比例达到 slow-start 阈值后，AM按 Job 配置申请 ReduceTask Container&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="160" x="140" y="416.38" as="geometry" />
        </mxCell>
        <mxCell id="yG9XSz6ooa5SpNMMEtbd-315" parent="yG9XSz6ooa5SpNMMEtbd-76" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b style=&quot;font-size: 11px; font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;步骤5&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-size: 11px; font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;.8&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-size: 11px; font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;：&lt;/font&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 11px; font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;AM&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;font face=&quot;Segoe UI&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;使用 RM 返回的Container，&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 11px; font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;并通过&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 255));&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;发起StartContainer,&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 255)); background-color: transparent; font-size: 11px;&quot;&gt;使得N&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 255)); background-color: transparent; font-size: 11px;&quot;&gt;odeManager&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 255)); background-color: transparent; font-size: 11px;&quot;&gt;在TaskContainer中启动&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;ReduceTask&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="180" x="660" y="410" as="geometry" />
