        <mxCell id="yG9XSz6ooa5SpNMMEtbd-134" parent="yG9XSz6ooa5SpNMMEtbd-162" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" value="&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;步骤3&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;.1&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;：&lt;/font&gt;&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Parser（语法解析）：&lt;br&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 解析 SQL，生成对应的&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Abstract Syntax Tree(&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;AST)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;抽象语法树&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;步骤3&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;.2&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;：&lt;/font&gt;&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Semantic Analyzer（&lt;/span&gt;语义分析&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;）：&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 根据AST访问 Metastore，确认表、字段、分区、文件格式、HDFS路径等，完成语义检验&lt;/span&gt;&lt;div&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;步骤3&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;.3&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;：&lt;/font&gt;&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Logical Plan Generator（生成逻辑计划）：&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; TableScan -&amp;gt; Filter -&amp;gt; GroupBy -&amp;gt; Select&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;步骤3&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;.4&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;：&lt;/font&gt;&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Optimizer（&lt;/span&gt;优化器&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;）&lt;/span&gt;：&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 分区裁剪、&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;列裁剪、&lt;/span&gt;谓词下推、MapJoin&lt;br&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;步骤3&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;.5&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;：&lt;/font&gt;&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Physical Plan Generator&lt;/span&gt;（生成物理计划）&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot;&gt;：&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;生成&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;QueryPlan（查询执行计划对象）&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;内部根据&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;hive.execution.engine&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;等配置生成&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;不同类型的 Hive Task(MapRedTask / TezTask / SparkTask)，&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+ 其他辅助Task + parent/child 依赖Tree&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Segoe UI&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="490" x="5" y="37" as="geometry" />
        </mxCell>
